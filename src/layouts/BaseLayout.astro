---
import '@/styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import { site } from '@/config/site';
import { absoluteUrl, cleanPath } from '@/lib/schema';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import FloatingActions from '@/components/layout/FloatingActions.astro';
import defaultOg from '@/assets/photos/lattes-mesa.jpg';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Recibe la URL absoluta de la imagen OG y devuelve los esquemas JSON-LD de la página */
  jsonLd?: (ogImage: string) => object[];
  noindex?: boolean;
  home?: boolean;
}

const {
  title,
  description = site.description,
  image = defaultOg,
  imageAlt = 'Cuatro capuchinos con arte latte sobre una mesa de madera',
  jsonLd,
  noindex = false,
  home = false,
} = Astro.props;

const path = cleanPath(Astro.url.pathname);
const fullTitle = title ? `${title} | ${site.name}` : `${site.legalName} en ${site.address.city} | ${site.slogan}`;
const canonical = absoluteUrl(path);
const og = await getImage({ src: image, width: 1200, height: 630, format: 'jpg', fit: 'cover', quality: 75 });
const ogUrl = absoluteUrl(og.src);
const schemas = jsonLd?.(ogUrl) ?? [];
---

<!doctype html>
<html lang={site.locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#2B1D16" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Tema sin parpadeo: se aplica antes de pintar -->
    <script is:inline>
      (() => {
        let t = null;
        try {
          t = localStorage.getItem('theme');
        } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
        document.documentElement.classList.add('js');
      })();
    </script>

    <Font cssVariable="--font-fraunces" preload={[{ subset: 'latin', style: 'normal' }]} />
    <Font cssVariable="--font-dmsans" preload={[{ subset: 'latin' }]} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col pb-[calc(4.5rem+env(safe-area-inset-bottom))] md:pb-0">
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Navbar home={home} />
    <main id="contenido" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer home={home} />
    <FloatingActions home={home} />

    <script>
      import { initReveal } from '@/scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
