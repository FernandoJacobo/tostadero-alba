---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { businessSchema } from '@/lib/schema';
import Hero from '@/components/sections/Hero.astro';
import Historia from '@/components/sections/Historia.astro';
import Marquee from '@/components/sections/Marquee.astro';
import Menu from '@/components/sections/Menu.astro';
import Granos from '@/components/sections/Granos.astro';
import Talleres from '@/components/sections/Talleres.astro';
import Galeria from '@/components/sections/Galeria.astro';
import Testimonios from '@/components/sections/Testimonios.astro';
import Reservacion from '@/components/sections/Reservacion.astro';
import Ubicacion from '@/components/sections/Ubicacion.astro';
---

<BaseLayout home jsonLd={(og) => [businessSchema(og)]}>
  <Hero />
  <Historia />
  <Marquee />
  <Menu />
  <Granos />
  <Talleres />
  <Galeria />
  <Testimonios />
  <Reservacion />
  <Ubicacion />
</BaseLayout>
