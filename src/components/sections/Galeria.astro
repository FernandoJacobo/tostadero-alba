---
import { site } from '@/config/site';
import { galeriaIntro as c } from '@/data/contenido';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Gallery from '@/components/islands/Gallery.astro';
import Icon from '@/components/ui/Icon.astro';

const instagram = site.social.find((s) => s.icon === 'instagram');
---

<section id="galeria" class="section" aria-labelledby="galeria-title">
  <div class="container-x">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <SectionHeading id="galeria-title" eyebrow={c.eyebrow} title={c.title} lead={c.lead} />
      {
        instagram && (
          <a href={instagram.href} class="btn btn-ghost self-start md:self-auto" rel="noopener" target="_blank" data-reveal>
            <Icon name="instagram" size={18} /> Síguenos en Instagram
          </a>
        )
      }
    </div>
    <div class="mt-12">
      <Gallery />
    </div>
  </div>
</section>
