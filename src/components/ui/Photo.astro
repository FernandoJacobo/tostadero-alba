---
/**
 * Foto optimizada con astro:assets (AVIF/WebP + srcset) dentro de un marco con aspect-ratio fijo (sin CLS).
 * Si la imagen falla, queda visible un fondo cálido con un grano de café como respaldo.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import LogoMark from './LogoMark.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Proporción CSS, p. ej. "4 / 3". Si se omite, el contenedor define el tamaño. */
  ratio?: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
  imgClass?: string;
  position?: string;
  zoom?: boolean;
}

const {
  src,
  alt,
  ratio,
  widths = [360, 540, 720, 960, 1280],
  sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
  priority = false,
  class: className = '',
  imgClass = '',
  position = 'center',
  zoom = false,
} = Astro.props;

// Si quien lo usa ya lo posiciona (absolute/fixed), no se agrega `relative` (chocaría con su clase).
const isPositioned = className.split(/\s+/).some((c) => c === 'absolute' || c === 'fixed');
---

<div
  class:list={['img-fallback overflow-hidden', !isPositioned && 'relative', zoom && 'zoom-img', className]}
  style={ratio ? `aspect-ratio: ${ratio}` : undefined}
>
  <LogoMark size={44} class="text-caramel/40 absolute inset-0 m-auto" />
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes}
    quality={62}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    class:list={['absolute inset-0 size-full object-cover', imgClass]}
    style={`object-position: ${position}`}
    onerror="this.style.visibility='hidden'"
  />
</div>
