---
import Title from './Title.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { id, eyebrow, title, lead, align = 'left', class: className = '' } = Astro.props;
---

<div class:list={[align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl', className]} data-reveal>
  <p class:list={['eyebrow', align === 'center' && 'justify-center']}>{eyebrow}</p>
  <Title id={id} text={title} class="mt-4" />
  {lead && <p class="lead mt-5">{lead}</p>}
  <slot />
</div>
