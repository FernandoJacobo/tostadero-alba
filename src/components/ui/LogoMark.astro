---
/** Símbolo original: grano de café con su hendidura y dos hilos de vapor. Usa currentColor para el grano. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 40 40"
  width={size}
  height={size}
  class:list={['logo-mark shrink-0', className]}
  aria-hidden="true"
  focusable="false"
>
  <g transform="rotate(-28 18 25)">
    <ellipse cx="18" cy="25" rx="9.5" ry="12.5" fill="currentColor"></ellipse>
    <path
      d="M18 13.2c-4.2 4.6 4.2 7.4 0 11.8s4.2 7.4 0 11.8"
      fill="none"
      stroke="var(--logo-cut, var(--bg))"
      stroke-width="2.3"
      stroke-linecap="round"></path>
  </g>
  <g fill="none" stroke="var(--caramel)" stroke-width="2.4" stroke-linecap="round" class="logo-steam">
    <path d="M27.5 12.5c-2.4-2.2 2.4-3.8 0-6.5"></path>
    <path d="M33 14.5c-2.4-2.2 2.4-3.8 0-6.5"></path>
  </g>
</svg>
