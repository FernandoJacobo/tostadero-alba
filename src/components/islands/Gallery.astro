---
/**
 * Galería tipo masonry (columnas CSS) con lightbox propio sobre <dialog>:
 * flechas del teclado, swipe en móvil, Escape para cerrar, foco atrapado por el modal
 * y regreso del foco a la foto que lo abrió. Sin JS, cada foto enlaza a su versión grande.
 */
import { getImage } from 'astro:assets';
import { gallery } from '@/data/galeria';
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';

const items = await Promise.all(
  gallery.map(async (g) => {
    const full = await getImage({ src: g.image, width: 1600, format: 'webp', quality: 72 });
    return { ...g, full: full.src };
  }),
);
---

<div data-gallery>
  <ul class="columns-2 gap-3 sm:gap-4 md:columns-3 lg:columns-4">
    {
      items.map((g, i) => (
        <li class="mb-3 break-inside-avoid sm:mb-4" data-reveal style={`--reveal-delay:${(i % 4) * 70}ms`}>
          <a
            href={g.full}
            class="zoom-trigger group relative block overflow-hidden rounded-2xl"
            data-index={i}
            data-full={g.full}
            data-caption={g.caption}
            data-alt={g.alt}
            aria-label={`Ver en grande: ${g.caption}`}
          >
            <Photo
              src={g.image}
              alt={g.alt}
              ratio={g.ratio}
              widths={[240, 360, 480, 640]}
              sizes="(min-width: 1024px) 280px, (min-width: 768px) 30vw, 46vw"
              class="rounded-2xl"
              zoom
            />
            <span class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center justify-between gap-2 bg-gradient-to-t from-black/70 to-transparent p-3 pt-10 text-sm font-semibold text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
              {g.caption}
              <Icon name="expand" size={16} />
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <dialog
    class="lightbox m-0 h-dvh max-h-none w-screen max-w-none bg-[#0d0806]/96 p-0 text-white backdrop:bg-transparent"
    aria-label="Galería de fotos"
    data-lightbox
  >
    <div class="relative flex h-full flex-col">
      <div class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <p class="text-sm font-semibold text-white/80 tabular-nums" aria-live="polite" data-lb-counter></p>
        <button
          type="button"
          class="inline-flex size-12 items-center justify-center rounded-full bg-white/10 hover:bg-white/20"
          aria-label="Cerrar galería"
          data-lb-close
        >
          <Icon name="x" size={24} />
        </button>
      </div>

      <figure class="relative flex min-h-0 flex-1 flex-col items-center justify-center px-4 pb-4 sm:px-20" data-lb-stage>
        <img data-lb-img alt="" class="max-h-full max-w-full touch-pan-y rounded-xl object-contain select-none" draggable="false" />
        <figcaption class="mt-4 text-center font-serif text-lg italic text-white/90" data-lb-caption></figcaption>
      </figure>

      <button
        type="button"
        class="absolute top-1/2 left-2 inline-flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 hover:bg-white/20 sm:left-5"
        aria-label="Foto anterior"
        data-lb-prev
      >
        <Icon name="chevron-left" size={26} />
      </button>
      <button
        type="button"
        class="absolute top-1/2 right-2 inline-flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 hover:bg-white/20 sm:right-5"
        aria-label="Foto siguiente"
        data-lb-next
      >
        <Icon name="chevron-right" size={26} />
      </button>
      <p class="sr-only">Usa las flechas izquierda y derecha para cambiar de foto y Escape para cerrar.</p>
    </div>
  </dialog>
</div>

<style>
  .lightbox[open] {
    animation: lb-in 0.25s ease;
  }
  .lightbox [data-lb-img] {
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .lightbox [data-lb-img].is-loading {
    opacity: 0;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const triggers = [...root.querySelectorAll<HTMLAnchorElement>('[data-full]')];
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lb-counter]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-lb-stage]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const preload = (i: number) => {
      const t = triggers[(i + triggers.length) % triggers.length];
      new Image().src = t.dataset.full!;
    };

    const show = (i: number, dir = 0) => {
      index = (i + triggers.length) % triggers.length;
      const t = triggers[index];
      img.classList.add('is-loading');
      img.style.transform = dir ? `translateX(${dir * 24}px)` : '';
      img.onload = () => {
        img.classList.remove('is-loading');
        img.style.transform = '';
      };
      img.src = t.dataset.full!;
      img.alt = t.dataset.alt!;
      caption.textContent = t.dataset.caption!;
      counter.textContent = `${index + 1} / ${triggers.length}`;
      preload(index + 1);
      preload(index - 1);
    };

    triggers.forEach((t, i) =>
      t.addEventListener('click', (e) => {
        e.preventDefault();
        opener = t;
        show(i);
        dialog.showModal();
        dialog.querySelector<HTMLButtonElement>('[data-lb-close]')!.focus();
      }),
    );

    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1, -1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1, 1));
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => opener?.focus());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(index + 1, 1);
      else if (e.key === 'ArrowLeft') show(index - 1, -1);
    });
    // Clic fuera de la foto (en el fondo) cierra
    stage.addEventListener('click', (e) => {
      if (e.target === stage) dialog.close();
    });

    // Swipe horizontal en pantallas táctiles
    let startX = 0;
    let startY = 0;
    let tracking = false;
    stage.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      tracking = true;
      startX = e.clientX;
      startY = e.clientY;
    });
    stage.addEventListener('pointermove', (e) => {
      if (!tracking) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > Math.abs(e.clientY - startY)) img.style.transform = `translateX(${dx * 0.6}px)`;
    });
    const end = (e: PointerEvent) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
      else img.style.transform = '';
    };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);
  });
</script>
